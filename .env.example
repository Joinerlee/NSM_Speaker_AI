# NSM AI Speaker - Environment Variables
# 이 파일을 .env로 복사하고 값을 설정하세요
# cp .env.example .env

# Google Gemini API Key (필수)
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_api_key_here

# Server Port (기본값: 3000)
PORT=3000

# Environment (development | production)
NODE_ENV=production

# Localtunnel Subdomain (선택)
# https://your-subdomain.loca.lt 형식으로 접속
TUNNEL_SUBDOMAIN=nsm-speaker
